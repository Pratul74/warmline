# Everything here is built into the public JavaScript bundle: anyone can read it. No secrets.

# Where the FastAPI backend runs. The backend must list this frontend's origin in its
# CORS_ALLOWED_ORIGINS (for local development: http://localhost:5173).
VITE_API_BASE_URL=http://localhost:8000

# The public address of this frontend, used for absolute link-preview URLs (og:image).
# No trailing slash.
VITE_SITE_URL=http://localhost:5173
