# Production settings. On the server: copy to /opt/warmline/.env, fill in, then
#   chmod 600 /opt/warmline/.env
# Never commit the real file, never paste it into chat or CI logs.
# Write values without quotes: deploy.sh and backup.sh read some of them with sed.
# DB_URL is not set here: docker-compose.prod.yml builds it from the POSTGRES_* values.

# Where the images live, without a tag. deploy.sh adds api-<sha> / web-<sha>.
REGISTRY_IMAGE=docker.io/your-dockerhub-user/warmline

# Database. Use a hex password (it goes inside a URL, so no special characters):
#   python3 -c "import secrets; print(secrets.token_hex(32))"
POSTGRES_USER=warmline
POSTGRES_PASSWORD=replace-with-a-64-character-hex-string
POSTGRES_DB=warmline

LOG_LEVEL=INFO

# Gemini. Use the production key, not your development key.
GEMINI_API_KEY=replace-me
GEMINI_MODEL=replace-with-the-model-you-chose
GEMINI_EMBEDDING_MODEL=replace-with-the-embedding-model
LLM_TIMEOUT_SECONDS=30

BUSINESS_TIMEZONE=UTC
AGENT_MAX_STEPS=6
AGENT_MAX_TOOL_RETRIES=2
LLM_INPUT_PRICE_PER_1M_TOKENS=0
LLM_OUTPUT_PRICE_PER_1M_TOKENS=0

# Login tokens. A new random value (never the development one):
#   python3 -c "import secrets; print(secrets.token_urlsafe(48))"
SECRET_KEY=replace-me
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30

# The public address (no trailing slash). Used for integration links and by deploy.sh
# for the health check (https://<domain>/api/health).
PUBLIC_CHAT_BASE_URL=https://your-domain.example

# Empty: the frontend and the API share one origin, so no CORS is needed.
CORS_ALLOWED_ORIGINS=

PUBLIC_CHAT_RATE_LIMIT=20
PUBLIC_CHAT_RATE_WINDOW_SECONDS=60

# Where backup.sh uploads dumps (bucket and prefix the instance role may write to).
BACKUP_S3_URI=s3://your-bucket/warmline-backups
