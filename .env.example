APP_ENV=development
LOG_LEVEL=INFO

POSTGRES_USER=warmline
POSTGRES_PASSWORD=change-me
POSTGRES_DB=warmline
DB_URL=postgresql+asyncpg://warmline:change-me@127.0.0.1:5433/warmline
TEST_DB_URL=postgresql+asyncpg://warmline:change-me@127.0.0.1:5433/warmline_test_db


GEMINI_API_KEY=your-gemini-api-key
GEMINI_MODEL=gemini-3.5-flash-lite
GEMINI_EMBEDDING_MODEL=gemini-embedding-2
LLM_TIMEOUT_SECONDS=30


BUSINESS_TIMEZONE=UTC

AGENT_MAX_STEPS=6
AGENT_MAX_TOOL_RETRIES=2


LLM_INPUT_PRICE_PER_1M_TOKENS=0
LLM_OUTPUT_PRICE_PER_1M_TOKENS=0


SECRET_KEY=change-me-to-a-random-string-of-at-least-32-characters
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30

PUBLIC_CHAT_BASE_URL=http://localhost:8000

PUBLIC_CHAT_RATE_LIMIT=20
PUBLIC_CHAT_RATE_WINDOW_SECONDS=60
